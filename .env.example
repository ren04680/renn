# Copy to .env and fill in. Without a key the system runs in offline mode automatically.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 1 = force offline deterministic mode (no LLM calls). Jury-day insurance.
DEMO_OFFLINE=0
# Seconds before an LLM call is abandoned and the offline logic takes over for that step
LLM_TIMEOUT=20
# Soft-hold TTL for proposed slots (seconds)
HOLD_TTL_SECONDS=300
# Hold TTL for proactive (event-driven) offers (seconds)
PROACTIVE_HOLD_TTL_SECONDS=900
# Embeddings: "auto" tries sentence-transformers/all-MiniLM-L6-v2, falls back to a local hashing embedder
EMBEDDINGS=auto
